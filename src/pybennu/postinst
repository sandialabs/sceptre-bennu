# $PIPINSTALL /tmp/pyhelics/helics-2.7.1/


# TODO: find a way to avoid this. FPM won't install dependencies automatically or bundle them, and not everything here can be added as apt dependencies unfortunately.
# These are dependencies that aren't apt packages or the version required is newer than is available in apt
# For example, pybennu requires pymodbus >=3.6.0, but ubuntu 22.04 apt has pymodbus 2.1.0
#
printf "\n\tINSTALLING PYBENNU PIP DEPENDENCIES...\n\n"
# dss-python (OpenDSS engine) ships no aarch64 wheels, so skip opendssdirect there; only the OpenDSS power solver needs it
OPENDSS='opendssdirect.py~=0.9.4'
case "$(uname -m)" in aarch64|arm64) OPENDSS=""; echo "NOTE: skipping opendssdirect.py (no wheels for $(uname -m)); the OpenDSS power solver is unavailable" ;; esac
$PIPINSTALL --ignore-installed 'elasticsearch<9.0.0' $OPENDSS 'py-expression-eval==0.3.14' 'PYPOWER==5.1.19' 'scipy>=1.15.0' 'labjack-ljm~=1.23.0' 'pymodbus>=3.8.0,<=3.9.2' 'pydantic>2.0.0,<3.0.0' 'pydantic-settings'

printf "\nDONE!!\n\n"
